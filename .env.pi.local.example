# Modèle pour .env.pi.local (non versionné, à créer une seule fois sur le
# Mac : `cp .env.pi.local.example .env.pi.local` puis compléter ci-dessous).
# `make deploy` pousse ce fichier sur le Pi en tant que .env.local, à côté de
# docker-compose.yml — pas besoin de le recréer manuellement sur le Pi.

DISPLAY_MODE=fbi
TOKEN=
API_URL=
