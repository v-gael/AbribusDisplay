# Fichier versionné (valeurs par défaut) — ne pas y mettre de secret ni de
# valeur propre à un poste/déploiement : créer .env.local (non versionné)
# pour TOKEN, API_URL, et toute autre surcharge.

# ---- Couleurs (format hex #RRGGBB) ----
TEXT_STOP_COLOR=#FFFFFF
TEXT_HOUR_COLOR=#FFFFFF
TEXT_HEADER_COLOR=#7baee2
TEXT_MINUTES_COLOR=#FFFFFF
TEXT_DIRECTION_COLOR=#FFFFFF
BACKGROUND_COLOR=#05203c
HEADER_BACKGROUND_COLOR=#1b4872

# ---- API ----
# Sensibles / spécifiques au déploiement : laissés vides ici, à définir dans
# .env.local (non versionné)
TOKEN=
API_URL=
API_VERIFY_SSL=true

# ---- Timings (secondes) ----
CALL_RATE=60
REFRESH_RATE=5

# ---- Rendu image ----
# Résolution de l'écran cible (adapter au HAT/écran utilisé sur le Pi)
IMAGE_WIDTH=480
IMAGE_HEIGHT=320
FONT_PATH=assets/fonts/RobotoCondensed-Bold.ttf

# ---- Sortie / affichage ----
# fbi  -> écrit l'image et pilote fbi sur /dev/fb1 (Pi)
# file -> écrit juste l'image dans OUTPUT_PATH (dev Mac/Linux)
DISPLAY_MODE=file
OUTPUT_PATH=output/display.png
FRAMEBUFFER_DEVICE=/dev/fb1
